# =============================================================
# .env.example - copy to .env and adjust
# =============================================================
#   cp .env.example .env            (Linux/macOS)
#   Copy-Item .env.example .env     (PowerShell)
#
# .env is git-ignored. In production these come from the platform.
# =============================================================

# ---- PostgreSQL (used by docker-compose.yml and the API) ----
POSTGRES_DB=rental_db
POSTGRES_USER=rental_user
POSTGRES_PASSWORD=rental_pass
DB_PORT=5432

# ---- API ----
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://rental_user:rental_pass@localhost:5432/rental_db
ENV=dev

# Generate a strong value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_ISSUER=apartment-rental-management
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed frontend origins (empty -> localhost:5173 dev default)
CORS_ORIGINS=

# Optional: promote/create an ADMIN on startup. Set the username (and the
# password if that user doesn't exist yet), start the app once, then remove.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# ---- Frontend (web/.env) ----
# Base URL the SPA uses to reach the API. Never hardcode this in code.
VITE_API_URL=http://localhost:8000
