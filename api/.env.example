# API-local env example. Copy to api/.env (git-ignored) when running
# the backend outside Docker with a non-default database.
DATABASE_URL=postgresql+asyncpg://rental_user:rental_pass@localhost:5432/rental_db
ENV=dev
JWT_SECRET=change-me-in-production
JWT_ISSUER=apartment-rental-management
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
